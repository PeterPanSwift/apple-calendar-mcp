#!/bin/sh
set -eu

console_user=$(/usr/bin/stat -f '%Su' /dev/console)
if [ -z "$console_user" ] || [ "$console_user" = "root" ] || [ "$console_user" = "loginwindow" ]; then
  echo "Apple Calendar MCP must be installed while a macOS user is logged in." >&2
  exit 1
fi

target_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
target_group=$(/usr/bin/id -gn "$console_user")
register_script="/Library/Application Support/AppleCalendarMCP/libexec/register-mcp-config"

/bin/sh "$register_script" "$target_home" "$console_user" "$target_group"

echo "Apple Calendar MCP installed. Restart ChatGPT to load the server."
exit 0
